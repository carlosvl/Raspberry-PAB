# Copy to .env and adjust for local development
# PAB_APP_NAME=Raspberry-PAB
# PAB_DISPLAY_TITLE=Raspberry-PAB
# PAB_LOG_LEVEL=INFO
# PAB_DATA_DIR=/home/pi/.local/share/raspberry-pab
# PAB_ADMIN_PIN=1234
# PAB_HOST=127.0.0.1
# PAB_BIND_HOST=0.0.0.0
# PAB_PORT=8080
# PAB_KIOSK_URL=http://127.0.0.1:8080
# PAB_WEB_DIR=/home/pi/Raspberry-PAB/web
# PAB_HOTSPOT_IFACE=wlan0
# PAB_HOTSPOT_CONNECTION=PAB-Hotspot
# PAB_HOTSPOT_SSID=Raspberry-PAB
# PAB_HOTSPOT_PASSWORD=RaspberryPAB123
# PAB_LED_ENABLED=true
# PAB_LED_ADDRESS=BE:28:79:00:06:CB
# PAB_LED_NAME="MELKL-OT21 CB"

# Production MCU: ESP32 combined (buzzer GPIO4 + matrix GPIO16). Same USB port for both.
# PAB_BUZZER_ENABLED=true
# PAB_BUZZER_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP210*-if00-port0
# PAB_BUZZER_MODE=active
# PAB_BUZZER_BAUD=115200

# PAB_MATRIX_ENABLED=true
# PAB_MATRIX_PORT=   # empty → uses PAB_BUZZER_PORT (combined board)
# PAB_MATRIX_WIDTH=96
# PAB_MATRIX_HEIGHT=8
# PAB_MATRIX_BRIGHTNESS=64
# PAB_MATRIX_BAUD=115200
# Music breaks / reminders need MATRIX enabled to scroll the panels:
# PAB_MATRIX_ENABLED=true
# PAB_MATRIX_PORT=/dev/ttyUSB0   # or leave empty to use PAB_BUZZER_PORT

# Alert sounds (PipeWire/Pulse → Bluetooth when connected, else HDMI).
# Files uploaded via Admin → Sounds. Pair speakers under Bluetooth speaker.
# Installer also adds pulseaudio-utils (pactl) for A2DP sink detection.
# PAB_SOUND_ENABLED=true
# PAB_SOUND_SINK=  # optional override; empty prefers bluez_output then HDMI

# Roku TV board (sideloaded channel). Auto-cast only when no HDMI (hdmi-fallback).
# PAB_ROKU_ENABLED=true
# PAB_ROKU_AUTOCAST=hdmi-fallback
# PAB_ROKU_CHANNEL_ID=dev
# PAB_ROKU_SCAN_INTERVAL=15
