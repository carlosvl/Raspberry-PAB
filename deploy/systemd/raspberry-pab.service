[Unit]
Description=Raspberry-PAB Kiosk Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Raspberry-PAB
EnvironmentFile=-/home/pi/Raspberry-PAB/.env
Environment=PYTHONPATH=/home/pi/Raspberry-PAB/src
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch:handle-suspend-key:handle-hibernate-key --who=Raspberry-PAB --why="Schedule kiosk must stay online" --mode=block /home/pi/Raspberry-PAB/scripts/run-server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
