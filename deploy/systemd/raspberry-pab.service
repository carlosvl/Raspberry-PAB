[Unit]
Description=Raspberry-PAB Kiosk Web Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/Raspberry-PAB
EnvironmentFile=-/home/pi/Raspberry-PAB/.env
Environment=PYTHONPATH=/home/pi/Raspberry-PAB/src
ExecStart=/home/pi/Raspberry-PAB/scripts/run-server.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
