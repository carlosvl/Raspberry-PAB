<?xml version="1.0" encoding="utf-8" ?>
<component name="PabBoardScene" extends="Scene">
  <script type="text/brightscript" uri="PabBoardScene.brs" />

  <interface>
    <field id="baseUrl" type="string" onChange="onBaseUrlChanged" />
  </interface>

  <children>
    <Rectangle
      id="bg"
      width="1920"
      height="1080"
      color="0x0F172AFF"
    />

    <Poster
      id="logoPoster"
      translation="[48,28]"
      width="72"
      height="72"
      visible="false"
      loadDisplayMode="scaleToFit"
    />

    <Label
      id="titleLabel"
      translation="[140,28]"
      width="1200"
      height="48"
      font="font:LargeBoldSystemFont"
      color="0xF8FAFCFF"
      text="Raspberry-PAB"
    />

    <Label
      id="dateLabel"
      translation="[140,78]"
      width="1200"
      height="32"
      font="font:SmallSystemFont"
      color="0x94A3B8FF"
      text=""
    />

    <Label
      id="clockLabel"
      translation="[1480,36]"
      width="400"
      height="64"
      horizAlign="right"
      font="font:LargeBoldSystemFont"
      color="0x38BDF8FF"
      text="--:--:--"
    />

    <Rectangle
      id="panelBg"
      translation="[40,130]"
      width="1840"
      height="800"
      color="0x111C33FF"
    />

    <Rectangle
      id="headerBg"
      translation="[40,130]"
      width="1840"
      height="56"
      color="0x152238FF"
    />

    <Label
      id="hName"
      translation="[64,142]"
      width="360"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="NAME"
    />
    <Label
      id="hRace"
      translation="[440,142]"
      width="340"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="RACE"
    />
    <Label
      id="hCallUp"
      translation="[800,142]"
      width="280"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="CALL UP"
    />
    <Label
      id="hStart"
      translation="[1100,142]"
      width="200"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="START TIME"
    />
    <Label
      id="hCountdown"
      translation="[1320,142]"
      width="220"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="COUNTDOWN"
    />
    <Label
      id="hResult"
      translation="[1560,142]"
      width="280"
      height="32"
      font="font:SmallBoldSystemFont"
      color="0x94A3B8FF"
      text="RESULT"
    />

    <MarkupGrid
      id="scheduleGrid"
      translation="[48,196]"
      itemComponentName="PabRowItem"
      numColumns="1"
      numRows="12"
      itemSize="[1824,56]"
      itemSpacing="[0,4]"
      drawFocusFeedback="false"
      focusable="false"
    />

    <Label
      id="emptyLabel"
      translation="[64,260]"
      width="1800"
      height="48"
      font="font:MediumSystemFont"
      color="0x94A3B8FF"
      text=""
      visible="false"
    />

    <Label
      id="pageLabel"
      translation="[48,950]"
      width="900"
      height="32"
      font="font:SmallSystemFont"
      color="0x64748BFF"
      text=""
    />

    <Label
      id="statusLabel"
      translation="[48,990]"
      width="1824"
      height="36"
      font="font:SmallSystemFont"
      color="0x38BDF8FF"
      text="Waiting for Raspberry-PAB…"
    />

    <Group id="alertOverlay" visible="false">
      <Rectangle
        id="alertBg"
        width="1920"
        height="1080"
        color="0x0F172AE6"
      />
      <Rectangle
        id="alertCard"
        translation="[360,260]"
        width="1200"
        height="420"
        color="0x152238FF"
      />
      <Label
        id="alertEyebrow"
        translation="[400,300]"
        width="1120"
        height="40"
        horizAlign="center"
        font="font:MediumBoldSystemFont"
        color="0x38BDF8FF"
        text="REMINDER"
      />
      <Label
        id="alertMessage"
        translation="[400,360]"
        width="1120"
        height="180"
        horizAlign="center"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF"
        wrap="true"
        text=""
      />
      <Label
        id="alertMeta"
        translation="[400,560]"
        width="1120"
        height="50"
        horizAlign="center"
        font="font:MediumSystemFont"
        color="0x94A3B8FF"
        text=""
      />
    </Group>
  </children>
</component>
